MONGO_URI=mongodb://localhost:27017/internship-tracker
JWT_SECRET=replace-with-a-local-secret
PORT=5000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_RETRIES=2
GEMINI_TIMEOUT_MS=20000

NEWS_CRON_ENABLED=false
NEWS_CRON_SCHEDULE=0 * * * *
NEWS_MAX_ARTICLES_PER_RUN=20
NEWS_LLM_REQUEST_BUDGET=20
NEWS_REQUEST_INTERVAL_MS=1000
NEWS_FEED_TIMEOUT_MS=10000
NEWS_ARTICLE_TIMEOUT_MS=10000
# Optional: Name|URL|Category entries separated by commas.
# NEWS_RSS_FEEDS=Example|https://example.com/feed.xml|Cloud
