MONGO_URI=mongodb://localhost:27017/internship-tracker
JWT_SECRET=replace-with-a-local-secret
PORT=5000

# Frontend origin(s) allowed by CORS, comma-separated, no trailing slash.
# e.g. CLIENT_URL=https://intern-diary.vercel.app
CLIENT_URL=
# Set to true to also allow Vercel preview deployments (https://*.vercel.app)
ALLOW_VERCEL_PREVIEWS=false
# Use "production" on Render. "development" allows every CORS origin.
NODE_ENV=development

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_RETRIES=2
GEMINI_TIMEOUT_MS=20000

# In-process cron. Render's free tier sleeps, so prefer the auto refresh below.
NEWS_CRON_ENABLED=false
NEWS_CRON_SCHEDULE=0 * * * *
# Start a background news refresh when news is requested and the newest
# article is older than NEWS_AUTO_REFRESH_HOURS. Set to false to disable.
NEWS_AUTO_REFRESH=true
NEWS_AUTO_REFRESH_HOURS=6
NEWS_MAX_ARTICLES_PER_RUN=20
NEWS_LLM_REQUEST_BUDGET=20
NEWS_REQUEST_INTERVAL_MS=1000
NEWS_FEED_TIMEOUT_MS=10000
NEWS_ARTICLE_TIMEOUT_MS=10000
# Optional: Name|URL|Category entries separated by commas.
# NEWS_RSS_FEEDS=Example|https://example.com/feed.xml|Cloud
